{{/if}}
{{#if (eq data 'tanstack-query-zustand')}}
| Server-state cache setup | `src/lib/query-client.ts` |
| Client-only global state | `src/stores/` |
{{/if}}
{{#if (eq auth 'workos')}}
| Auth session & redirects | `src/proxy.ts` (AuthKit), callback at `src/app/callback/route.ts` |
{{/if}}
{{#if (eq auth 'firebase')}}
| Auth client & config | `src/lib/firebase.ts` |
{{/if}}
{{#if (eq styling 'ui-core')}}
| Shared UI primitives & `cn()` | `@cleeviox/ui-core` (re-export in `src/lib/cn.ts`) |
{{/if}}
{{#if figmaUrl}}
| Design tokens (generated from Figma) | `src/app/theme.css` |
{{/if}}
{{#if (eq styling 'shadcn')}}
