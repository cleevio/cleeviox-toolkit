{
  "bin": {
    "create-web-template": "./dist/index.js"
  },
  "bugs": {
    "url": "https://github.com/cleevio/cleeviox-toolkit/issues"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "handlebars": "^4.7.9",
    "picocolors": "^1.1.1",
    "sort-package-json": "^4.0.0"
  },
  "description": "Interactive generator for Cleevio Next.js applications",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "templates",
    "public/"
  ],
  "keywords": [
    "create",
    "generator",
    "nextjs",
    "scaffold",
    "cleevio",
    "cleeviox"
  ],
  "name": "@cleeviox/create-web-template",
  "repository": {
    "directory": "packages/create-web-template",
    "type": "git",
    "url": "https://github.com/cleevio/cleeviox-toolkit"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "check": "biome check --write .",
    "clean": "del .turbo tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo dist coverage node_modules",
    "fix": "run-s biome:check:fix ts",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "prebuild": "del dist tsconfig.build.tsbuildinfo",
    "test": "bun test",
    "test:cov": "bun test --coverage --coverage-reporter=lcov",
    "test:watch": "bun test --watch",
    "ts": "tsc --build tsconfig.json"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.0.0"
}
