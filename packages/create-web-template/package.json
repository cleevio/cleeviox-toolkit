{
  "bin": {
    "create-web-template": "./dist/index.js"
  },
  "bugs": {
    "url": "https://github.com/cleevio/cleeviox-toolkit/issues"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "handlebars": "^4.7.9",
    "picocolors": "^1.1.1",
    "sort-package-json": "^4.0.0"
  },
  "description": "Interactive generator for Cleevio Next.js applications",
  "devDependencies": {
    "@cleeviox/ui-core": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@storybook/nextjs": "^10.5.6",
    "@tanstack/react-query": "^5.101.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.18",
    "@workos-inc/authkit-nextjs": "^4.3.1",
    "clsx": "^2.1.1",
    "firebase": "^12.17.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.6",
    "tailwind-merge": "^3.6.0",
    "typescript": "^6.0.3",
    "zustand": "^5.0.14"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "files": [
    "dist",
    "templates",
    "public/"
  ],
  "keywords": [
    "create",
    "generator",
    "nextjs",
    "scaffold",
    "cleevio",
    "cleeviox"
  ],
  "name": "@cleeviox/create-web-template",
  "repository": {
    "directory": "packages/create-web-template",
    "type": "git",
    "url": "https://github.com/cleevio/cleeviox-toolkit"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "check": "biome check --write .",
    "clean": "del .turbo tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo dist coverage node_modules",
    "fix": "run-s biome:check:fix ts",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "postbuild": "chmod +x dist/index.js",
    "prebuild": "del dist tsconfig.build.tsbuildinfo",
    "test": "bun test",
    "test:cov": "bun test --coverage --coverage-reporter=lcov",
    "test:watch": "bun test --watch",
    "ts": "run-s ts:src ts:templates",
    "ts:src": "tsc --build tsconfig.json",
    "ts:templates": "tsc --project templates/tsconfig.json"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.0.0"
}
